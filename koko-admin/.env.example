# ===== KOKO 管理后台环境变量（复制为 .env 后填写；.env 不入库）=====

# BFF 监听端口（容器内）
PORT=8093

# Docker 网络名：必须与现有 Caddy / Mongo / Delta 所在网络一致
# 服务器上用 `docker network ls` 查看，通常类似 revolt_default
REVOLT_NETWORK=revolt_default

# MongoDB：使用 deploy/mongo-init.js 创建的最小权限账号
# 主机名填 Mongo 容器在该网络内的容器名/服务名（如 mongo）
MONGO_URI=mongodb://koko_admin_bff:CHANGE_ME_STRONG_PASSWORD@mongo:27017/?authSource=admin&retryWrites=true
MONGO_REVOLT_DB=revolt
MONGO_ADMIN_DB=koko_admin

# JWT 签名密钥：至少 32 位随机字符串，可用 `openssl rand -hex 32` 生成
JWT_SECRET=CHANGE_ME_32_BYTES_RANDOM
# JWT 有效期（小时）
JWT_TTL_HOURS=12

# Delta（Stoat API）服务端管理员会话
# 先通过 `stoat-cli account promote <userId>` 提权一个专用账号，
# 再用该账号登录 Delta（POST /auth/session/login）取得 token，填到这里。
# 定期轮换；BFF 只在服务端使用，永不下发前端。
DELTA_BASE_URL=http://delta:8000
DELTA_ADMIN_TOKEN=CHANGE_ME_SESSION_TOKEN
# 会话 token 用 X-Session-Token；若改用 Bot 则填 X-Bot-Token 并相应调整
DELTA_TOKEN_HEADER=X-Session-Token

# Autumn 文件服务地址（保留给健康检查等只读用途；v0.15.5 无删除接口）
AUTUMN_BASE_URL=http://autumn:14704

# MinIO 对象存储（删除媒体文件本体用；不配置则删除只清 Mongo 索引）
# 凭据与 Stoat compose 中 MINIO_ROOT_USER/MINIO_ROOT_PASSWORD 一致
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=CHANGE_ME_MINIO_USER
MINIO_SECRET_KEY=CHANGE_ME_MINIO_PASSWORD
MINIO_BUCKET=revolt-uploads

# CORS：仅本地开发需要（生产同源，无需放行）
CORS_ORIGINS=http://localhost:5199,http://127.0.0.1:5199

# 声网 Agora 语音房管理（不配置则"语音房"页面不可用，其余功能不受影响）
# AGORA_APP_ID / AGORA_APP_CERT 与 koko-auth .env 中一致；
# 云端频道管理 REST API 另需 Customer ID / Customer Secret：
# 声网控制台 → 开发者工具（RESTful API / 服务端 API）页面生成，注意不是 App 证书。
AGORA_APP_ID=
AGORA_CUSTOMER_ID=
AGORA_CUSTOMER_SECRET=
# API 域名默认 https://api.agora.io；国内服务器如有网络问题可切备用域名
#AGORA_API_BASE=https://api.sd-rtn.com

# 登录来源 IP 白名单（逗号分隔；留空 = 不限制）。
# 注意：经 Caddy 反代时取 X-Forwarded-For 首跳，务必先确认真实客户端 IP 再启用，误配会锁死登录。
ALLOWED_IPS=

# 首次启动种子超管（仅当账号表为空时生效；建完账号后建议清空）
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_FIRST_LOGIN_PASSWORD
